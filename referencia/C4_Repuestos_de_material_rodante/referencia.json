  "items": [
    {
      "id": "AF-01",
      "grupo": "A",
      "titulo": "Existencia de la orden de compra",
      "texto": "En fecha 18 de julio de 2025 la demandada emitió la orden de compra N° 430014908, tramitada bajo el expediente EX-2025-00611240-APN-GMR#SOTR, para el suministro de repuestos destinados a su material rodante.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-02",
      "grupo": "A",
      "titulo": "Objeto de la orden de compra",
      "texto": "La orden de compra comprendió cinco renglones: zapatas de freno compuestas, amortiguadores verticales de suspensión secundaria, bujes elásticos de brazo de arrastre, placas de desgaste de patín de tercer riel y juntas de estanqueidad para puertas de acceso.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-03",
      "grupo": "A",
      "titulo": "Plazo de pago pactado",
      "texto": "El pago de cada entrega se convino a los noventa (90) días corridos de la presentación de la factura respectiva.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-04",
      "grupo": "A",
      "titulo": "Documentación exigida al proveedor",
      "texto": "La orden de compra no exigió a mi mandante la presentación de certificados de origen ni de trazabilidad, extremo que la demandada introdujo con posterioridad y sin sustento contractual.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-05",
      "grupo": "B",
      "titulo": "Entrega de la totalidad de los renglones",
      "texto": "Mi mandante entregó la totalidad de los repuestos comprendidos en los cinco renglones de la orden de compra, en las cantidades allí previstas.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-06",
      "grupo": "B",
      "titulo": "Calidad del material entregado",
      "texto": "El material entregado responde íntegramente a las especificaciones técnicas requeridas y fue aceptado sin observación de calidad alguna.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-07",
      "grupo": "C",
      "titulo": "Importe de la primera factura",
      "texto": "La factura N° 0007-00000512, de fecha 22 de septiembre de 2025, fue emitida por la suma de $ 31.480.200,00.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-08",
      "grupo": "C",
      "titulo": "Ausencia de observaciones a las facturas",
      "texto": "Ninguna de las facturas emitidas fue observada ni objetada por la demandada dentro de los plazos legales, por lo que constituyen cuenta líquida y exigible.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-09",
      "grupo": "D",
      "titulo": "Carta documento",
      "texto": "En fecha 29 de enero de 2026 mi parte remitió a la demandada la carta documento N° CD 245118036, intimándola al pago en el plazo de cuarenta y ocho (48) horas bajo apercibimiento de iniciar las acciones judiciales pertinentes. La pieza postal fue efectivamente entregada y no mereció respuesta alguna.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-10",
      "grupo": "D",
      "titulo": "Pronto despacho",
      "texto": "En fecha 4 de febrero de 2026 se presentó ante la Mesa de Entradas de la demandada la nota de pronto despacho N° RA-2026-00147, cuya recepción consta con el sello de Mesa General de Entradas, SOTR S.E..",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-11",
      "grupo": "D",
      "titulo": "Silencio de la demandada",
      "texto": "Ninguna de las presentaciones referidas fue respondida por la demandada dentro de los plazos que la normativa aplicable le impone, configurándose el silencio que habilita la presente acción.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-12",
      "grupo": "E",
      "titulo": "Suma total reclamada",
      "texto": "El total reclamado en autos asciende a PESOS NOVENTA Y DOS MILLONES SETECIENTOS CUARENTA Y CUATRO MIL CIENTO OCHENTA CON 00/100 ($ 92.744.180,00), conforme el detalle que antecede y la certificación contable que se acompaña.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-13",
      "grupo": "E",
      "titulo": "Fecha de constitución en mora",
      "texto": "La demandada quedó constituida en mora de pleno derecho el 6 de diciembre de 2025, por haber vencido el plazo pactado sin que mediara pago ni observación alguna.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-14",
      "grupo": "E",
      "titulo": "Intereses pretendidos",
      "texto": "Se reclaman los intereses devengados desde la fecha de mora y hasta el efectivo pago, a la tasa activa del Banco de la Nación Argentina para operaciones de descuento a treinta días, con más las costas del proceso.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-15",
      "grupo": "E",
      "titulo": "Inexistencia de pagos parciales",
      "texto": "La demandada no efectuó pago alguno, ni total ni parcial, imputable a la obligación que se reclama en autos.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    }
  ],
