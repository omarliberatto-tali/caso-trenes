  "items": [
    {
      "id": "AF-01",
      "grupo": "A",
      "titulo": "Existencia del contrato de servicio",
      "texto": "En fecha 3 de junio de 2024 la demandada adjudicó a mi mandante el contrato CT-42/2024, tramitado bajo el expediente EX-2024-00297714-APN-GIN#SOTR, para el mantenimiento de vía del ramal Retiro — Villa Rosa.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-02",
      "grupo": "A",
      "titulo": "Alcance del servicio contratado",
      "texto": "El contrato comprendió, además de las tareas de vía, la provisión de un servicio de guardia permanente los siete días de la semana y la atención de emergencias dentro de las dos horas de requerida, con dotación propia y equipamiento afectado en forma exclusiva al ramal.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-03",
      "grupo": "A",
      "titulo": "Régimen de precios",
      "texto": "Los precios unitarios convenidos son redeterminables conforme la variación de los índices de la construcción publicados por el I.N.D.E.C., mecanismo que la demandada nunca aplicó pese a los reclamos de mi mandante.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-04",
      "grupo": "A",
      "titulo": "Plazo de pago pactado",
      "texto": "El pago de cada certificación mensual se convino a los sesenta (60) días corridos de su presentación, plazo que se encuentra vencido respecto de las cuatro certificaciones que se reclaman.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-05",
      "grupo": "B",
      "titulo": "Conformidad de la Inspección de Obra",
      "texto": "La totalidad de los partes de servicio fue conformada por la Inspección de Obra de la demandada, sin observación alguna respecto de las tareas ejecutadas.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-06",
      "grupo": "B",
      "titulo": "Metros de vía intervenidos",
      "texto": "Durante el período reclamado mi mandante intervino cuatro mil doscientos (4.200) metros de vía principal ascendente en tareas de rebaje de riel por amolado.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-07",
      "grupo": "C",
      "titulo": "Importe de la certificación de noviembre",
      "texto": "La certificación correspondiente al mes de noviembre de 2025, instrumentada en la factura N° 0003-00001288, asciende a $ 43.525.126,57.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-08",
      "grupo": "C",
      "titulo": "Ausencia de observaciones a las certificaciones",
      "texto": "Ninguna de las certificaciones presentadas fue observada ni objetada por la demandada dentro de los plazos previstos en el contrato.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 2
      }
    },
    {
      "id": "AF-09",
      "grupo": "D",
      "titulo": "Intercambio de correo electrónico",
      "texto": "Con anterioridad a promover la presente acción mi mandante mantuvo con la demandada un intercambio de correo electrónico en el que reclamó el pago de lo adeudado, sin obtener respuesta que lo satisficiera.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-10",
      "grupo": "D",
      "titulo": "Carta documento",
      "texto": "En fecha 16 de enero de 2026 mi parte remitió a la demandada la carta documento N° CD 231907744, intimándola al pago en el plazo de cuarenta y ocho (48) horas bajo apercibimiento de iniciar las acciones judiciales pertinentes. La pieza postal fue efectivamente entregada y no mereció respuesta alguna.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-11",
      "grupo": "D",
      "titulo": "Pronto despacho",
      "texto": "En fecha 22 de enero de 2026 se presentó ante la Mesa de Entradas de la demandada la nota de pronto despacho N° RA-2026-00092, cuya recepción consta con el sello de Mesa General de Entradas, SOTR S.E..",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-12",
      "grupo": "E",
      "titulo": "Suma total reclamada",
      "texto": "El total reclamado en autos asciende a PESOS CIENTO OCHENTA Y SEIS MILLONES CUATROCIENTOS TREINTA MIL NOVECIENTOS DOCE CON 44/100 ($ 186.430.912,44), conforme el detalle que antecede y la certificación contable que se acompaña.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-13",
      "grupo": "E",
      "titulo": "Fecha de constitución en mora",
      "texto": "La demandada quedó constituida en mora de pleno derecho el 3 de febrero de 2026, por haber vencido el plazo pactado sin que mediara pago ni observación alguna.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-14",
      "grupo": "E",
      "titulo": "Intereses pretendidos",
      "texto": "Se reclaman los intereses devengados desde la fecha de mora y hasta el efectivo pago, a la tasa activa del Banco de la Nación Argentina para operaciones de descuento a treinta días, capitalizable, con más las costas del proceso.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    },
    {
      "id": "AF-15",
      "grupo": "E",
      "titulo": "Inexistencia de pagos parciales",
      "texto": "La demandada no efectuó pago alguno, ni total ni parcial, imputable a la obligación que se reclama en autos.",
      "origen": {
        "documento_id": "DEM",
        "pagina": 3
      }
    }
  ],
